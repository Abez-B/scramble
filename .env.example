# --- Database (Turso) ------------------------------------------------
# turso db create scramble
# turso db show scramble --url        -> TURSO_DATABASE_URL
# turso db tokens create scramble     -> TURSO_AUTH_TOKEN
# Leave both empty to use a local SQLite file (scramble.db) for development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- App -------------------------------------------------------------
# Public base URL, used inside the QR code. Falls back to the request URL.
# BASE_URL=https://scramble.fly.dev
# LOCAL_DB_PATH=scramble.db

# --- Real-time (Cloudflare Worker + Durable Objects) -----------------
# The Worker URL for the real-time WebSocket layer.
# Leave empty to disable real-time and keep using polling.
REALTIME_WORKER_URL=
# Shared secret between FastAPI and the Worker for authenticating notifications.
NOTIFY_SECRET=

